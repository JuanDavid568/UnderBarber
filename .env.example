# Copia este archivo a backend/.env para desarrollo local (NO subas .env al repositorio)

NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/underbarber
# true si tu proveedor exige SSL en la conexión (conexiones externas de Render, Neon, Supabase…)
DATABASE_SSL=false

# Secreto para firmar sesiones: en producción mínimo 32 caracteres aleatorios
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Cuentas iniciales (se crean solo la primera vez, con la base vacía)
ADMIN_EMAIL=admin@underbarber.com
ADMIN_PASSWORD=
BARBER_DEFAULT_PASSWORD=

# Opcionales
SHOP_UTC_OFFSET=-05:00     # Colombia
MIN_LEAD_MINUTES=30        # antelación mínima para reservar
MAX_DAYS_AHEAD=60          # hasta cuántos días adelante se puede reservar
CORS_ORIGIN=               # solo si el frontend se sirve desde otro dominio
